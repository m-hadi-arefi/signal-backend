# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=signals
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKER=kafka:9092

# ── Telegram API ──────────────────────────────────────────────────────────────
# Get from https://my.telegram.org/apps
API_ID=
API_HASH=
PHONE=
SESSION_STRING_TELEGRAM=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPEN_AI_GPT=

# ── Claude Gateway ────────────────────────────────────────────────────────────
AI_PARSER_URL=http://claude-gateway:8000/parse
# Path to your Claude config directory (contains auth/session)
# Linux/Mac:  CLAUDE_HOME=/home/youruser/.claude
# Windows:    CLAUDE_HOME=C:/Users/youruser/.claude
CLAUDE_HOME=

# ── Matomo Analytics (optional — leave empty to disable) ──────────────────────
MATOMO_URL=
MATOMO_SITE_ID=1
MATOMO_TOKEN=

# ── Office Admin Panel ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
